# Environment variables for godmod3-mcp and the G0DM0D3 API container.
#
# There are two ways to run the API + bridge:
#
# 1. Split containers (recommended):
#      docker compose -f docker-compose.api.yml up -d --build
#      docker compose -f docker-compose.bridge-http.yml up -d --build
#
#    The HTTP bridge container reaches the API on the shared Docker network
#    at http://godmod3-api:7860. A local stdio bridge for Hermes reaches the
#    API at http://localhost:7860 (the published port).
#
# 2. Full stack at once:
#      docker compose up -d --build

# ---------------------------------------------------------------------------
# G0DM0D3 API container
# ---------------------------------------------------------------------------

# Port the API listens on inside the container (published to the host as 7860)
PORT=7860

# Bearer token if you want to protect the API (used by the upstream container)
GODMODE_API_KEY=my-local-key-123

# Tier assignment for the API key. Format: enterprise:key1,pro:key2
# Without this, all keys default to the Free tier (5 total, 10/min, 50/day).
# Example for unlimited local use with the key above:
# GODMODE_TIER_KEYS=enterprise:your-local-key-here
GODMODE_TIER_KEYS=enterprise:my-local-key-123

# OpenRouter key passed to G0DM0D3 if not configured server-side (optional)
# OPENROUTER_API_KEY=sk-or-v1-...

# HuggingFace tokens for dataset publishing (optional)
# HF_TOKEN=hf_...
# HF_DATASET_REPO=pliny-the-prompter/g0dm0d3

# ---------------------------------------------------------------------------
# godmod3-mcp bridge
# ---------------------------------------------------------------------------

# G0DM0D3 API base URL.
# - For a local stdio bridge talking to the API container: http://localhost:7860
# - For the HTTP bridge container talking to the API container on the same
#   Docker network: http://godmod3-api:7860
GODMOD3_BASE_URL=http://localhost:7860

# Bearer token if your G0DM0D3 API requires auth (must match GODMODE_API_KEY)
GODMOD3_API_KEY=my-local-key-123

# MCP transport: stdio, http, or sse (default stdio)
# - Use stdio for Hermes (the bridge runs as a subprocess launched by Hermes).
# - Use http for Odysseus when running the bridge as a container/service.
GODMOD3_MCP_TRANSPORT=stdio

# Port used when GODMOD3_MCP_TRANSPORT=http (default 3001)
GODMOD3_MCP_HTTP_PORT=3001
