# G0DM0D3 API base URL (defaults to localhost if unset)
GODMOD3_BASE_URL=http://localhost:7860

# Bearer token if your G0DM0D3 API requires auth (optional for local dev)
GODMOD3_API_KEY=

# MCP transport: stdio or http (default stdio)
GODMOD3_MCP_TRANSPORT=stdio

# Port used when GODMOD3_MCP_TRANSPORT=http (default 3001)
GODMOD3_MCP_HTTP_PORT=3001

# OpenRouter key passed to G0DM0D3 if not configured server-side (optional)
# OPENROUTER_API_KEY=sk-or-v1-...

# HuggingFace tokens for dataset publishing (optional)
# HF_TOKEN=hf_...
# HF_DATASET_REPO=pliny-the-prompter/g0dm0d3
